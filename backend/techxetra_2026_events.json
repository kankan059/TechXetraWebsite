  "events": [
    {
      "event_number": 1,
      "id": "00000000-0000-4000-8000-000000000101",
      "name": "HackXetra: Hackathon",
      "category": "TECHNICAL",
      "sub_category": "Departmental",
      "organizer": "TU-CODES",
      "description": "A 48-hour intense product development sprint hackathon under TechXetra, Tezpur University. Participating teams pick a real-world problem statement and build it into a production-grade working product. Evaluated purely on live product demonstration and market value without PPT presentations.",
      "is_team_event": true,
      "min_team_size": 2,
      "max_team_size": 5,
      "eligibility": "Undergraduate students in India with valid student ID",
      "registration": {
        "platform": "Unstop",
        "registration_fee_inr": 100,
        "fee_type": "Per person",
        "accommodation_and_food_fee_inr": 300,
        "accommodation_notes": "Charged separately for participants requiring on-campus stay/meals"
      },
      "tracks": [
        {
          "name": "AI & Automation",
          "scope": "Management agents, copilots, workflow automation"
        },
        {
          "name": "Cloud & Domain",
          "scope": "Cloud-native tools, infrastructure, domain-specific platforms"
        },
        {
          "name": "Agentic Workflow",
          "scope": "Multi-step autonomous agents, task orchestration, AI-driven pipelines"
        },
        {
          "name": "Sustainability",
          "scope": "Carbon emission control, cost optimization, energy efficiency, resource/waste"
        }
      ],
      "rules": [
        "Team size must be 2-5 members; no member may belong to more than one team.",
        "All code must be written during the 48-hour build sprint window.",
        "AI tool usage (Copilot, Claude, ChatGPT, Cursor, v0, etc.) is fully permitted and encouraged; tools used must be noted in the project README.",
        "Pre-built products are prohibited; commit history will be spot-checked.",
        "Source code must be version-controlled and pushed to GitHub prior to the deadline.",
        "No slide-deck (PPT) presentations allowed; evaluation is based strictly on live product demo and short pitch.",
        "One problem statement per team with cap enforced per problem statement on a first-come basis."
      ],
      "evaluation_criteria": [
        {
          "criterion": "Uniqueness",
          "weight_percentage": 20,
          "focus": "Originality and novelty of the proposed solution"
        },
        {
          "criterion": "Technical Execution",
          "weight_percentage": 25,
          "focus": "Code quality, architecture and depth of technical implementation"
        },
        {
          "criterion": "Robustness",
          "weight_percentage": 20,
          "focus": "Stability, reliability and completeness of the working build"
        },
        {
          "criterion": "Real-World Impact & Market Value",
          "weight_percentage": 20,
          "focus": "Practical relevance, scalability and commercial/market potential"
        },
        {
          "criterion": "Pitch & Demo",
          "weight_percentage": 15,
          "focus": "Clarity, persuasiveness and confidence of live product pitch"
        }
      ],
      "prizes": {
        "total_prize_pool_inr": 45000,
        "breakdown": [
          {
            "position": "Winner (1st Prize)",
            "prize_inr": 25000,
            "reward": "Rs. 25,000 + Certificate"
          },
          {
            "position": "Runner-up (2nd Prize)",
            "prize_inr": 12000,
            "reward": "Rs. 12,000 + Certificate"
          },
          {
            "position": "Second Runner-up (3rd Prize)",
            "prize_inr": 8000,
            "reward": "Rs. 8,000 + Certificate"
          }
        ],
        "notes": "Each track may also carry its own independent prize."
      },
      "timeline": [
        {
          "stage": "Day 0",
          "activities": "Registration closes on Unstop; Team IDs allotted"
        },
        {
          "stage": "Day 1",
          "activities": "Check-in & verification, Opening ceremony, Track & problem statement release, 48-hour build sprint begins, Lunch break, Mentorship Round 1"
        },
        {
          "stage": "Day 2",
          "activities": "Lunch break, Mentorship Round 2, Technical workshop"
        },
        {
          "stage": "Day 3",
          "activities": "Lunch break, Final GitHub submission deadline, Live product demos, Judging, Winner announcement & prize distribution, After-party / networking event"
        }
      ],
      "submitted_by": "Shujan Mashuq Islam (B.Tech CS, 5th Sem, CSB24067)"
    },
